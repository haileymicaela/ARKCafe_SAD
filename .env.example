# Copy this file to `.env` in the project root and fill in your values.
# `.env` is ignored by Git, so the key is never committed.
#
# Windows:   copy .env.example .env
# Git Bash:  cp .env.example .env
# Then edit `.env` in any text editor. No terminal exports needed.

TEXTBEE_ENABLED=True
TEXTBEE_API_KEY=txb_your_api_key_here
TEXTBEE_DEVICE_ID=your_device_id_here

# Turn SMS off without deleting the key:
# TEXTBEE_ENABLED=False

# Optional: log the message instead of sending it.
# TEXTBEE_DRY_RUN=True

# Optional: only alert the NCR's department instead of every recipient.
# TEXTBEE_NOTIFY_ALL_RECIPIENTS=False

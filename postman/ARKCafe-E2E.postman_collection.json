{"info":{"_postman_id":"c4e2d5b6-2222-4a7b-9c8d-2b3c4d5e6f7a","name":"ARKCafe NCR - End-to-End Tests","description":"End-to-end testing through Postman for the ARKCafe / Crimson NCR Django project.\n\nTwo complete user journeys, run top to bottom, with an assertion at every step:\n  Journey A - Admin : login -> dashboards -> create project & department -> verify -> audit -> cleanup -> logout\n  Journey B - Staff : login -> dashboard -> raise NCR -> progress -> resolve -> audit -> export -> logout\n\nPrereqs:\n  - Django dev server running on {{baseUrl}} (default http://127.0.0.1:8000)\n  - Environment 'ARKCafe - Local Dev' selected with real admin/staff credentials\n  - At least one Project and one Department already in the DB (Journey B picks IDs from the records page)\n\nDjango sessions + CSRF are handled automatically: the collection-level script keeps\n{{csrfToken}} synced with the csrftoken cookie; every POST sends X-CSRFToken.\n\nNOTE: all URLs include Django's required trailing slash. Do not remove it -\nDjango cannot redirect a POST to the slashed URL without losing the POST data.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Journey A - Admin","item":[{"name":"0a. Open /login/ (acquire a CSRF cookie)","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Clear per-run variables so a previous failed run cannot leak IDs","['projectId','departmentId','ncrId','projectCode','projectName','departmentName','ncrRef','uniq']","  .forEach(function(k){ pm.collectionVariables.unset(k); });"]}},{"listen":"test","script":{"type":"text/javascript","exec":["// A live session from a previous run returns 302 to that role's dashboard - that is fine here","pm.test('Login route reachable', () => pm.expect([200, 302]).to.include(pm.response.code));"]}}],"request":{"method":"GET","header":[],"description":"Guarantees the csrftoken cookie exists so the next POST /logout/ is not rejected.","url":"{{baseUrl}}/login/"}},{"name":"0b. Ensure signed out (POST /logout/)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Sign-out attempted', () => pm.expect([200, 302, 403]).to.include(pm.response.code));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"description":"Clears any session left by an earlier failed run so step 1 really tests the anonymous case.","url":"{{baseUrl}}/logout/"}},{"name":"1. Open / (anonymous) - lands on login page","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Lands on login page (200)', () => pm.expect(pm.response.code).to.eql(200));","pm.test('Email field present', () => pm.expect(pm.response.text()).to.include('name=\"username\"'));"]}}],"request":{"method":"GET","header":[],"description":"Follows the redirect chain / -> /login/ like a real browser.","url":"{{baseUrl}}/"}},{"name":"2. Login as ADMIN","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Redirected (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent to an admin dashboard', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.match(/admin-dashboard|reports\\/admin\\/dashboard/));","pm.test('sessionid cookie issued', () => pm.expect(!!pm.cookies.get('sessionid')).to.be.true);"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"{{adminEmail}}","type":"text"},{"key":"password","value":"{{adminPassword}}","type":"text"}]},"url":"{{baseUrl}}/login/"}},{"name":"3. Admin dashboard visible","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Dashboard 200', () => pm.expect(pm.response.code).to.eql(200));","pm.test('App shell rendered', () => pm.expect(pm.response.text()).to.include('Crimson NCR'));","pm.test('Admin-only shell rendered (admin sidebar link)', () =>","  pm.expect(pm.response.text()).to.include('/admin-users/'));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/admin-dashboard/"}},{"name":"4. Reports admin dashboard visible","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Reports dashboard 200', () => pm.expect(pm.response.code).to.eql(200));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/reports/admin/dashboard/"}},{"name":"5. Create a new project","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('projectCode', 'E2E-' + Date.now());","pm.collectionVariables.set('projectName', 'E2E Project ' + Date.now());"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Project created (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent back to projects list', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.include('admin-projects'));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"project_name","value":"{{projectName}}","type":"text"},{"key":"client_name","value":"E2E Client","type":"text"},{"key":"project_code","value":"{{projectCode}}","type":"text"},{"key":"description","value":"E2E admin journey","type":"text"}]},"url":"{{baseUrl}}/admin-projects/add/"}},{"name":"6. Create a new department","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('departmentName', 'E2E Dept ' + Date.now());"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Department created (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent back to departments list', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.include('admin-departments'));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"action","value":"add","type":"text"},{"key":"add-department_name","value":"{{departmentName}}","type":"text"}]},"url":"{{baseUrl}}/admin-departments/"}},{"name":"7. Verify project appears in admin list","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Project visible in list', () => pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('projectCode')));","var escCode = pm.collectionVariables.get('projectCode').replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');","const m = pm.response.text().match(new RegExp('admin-projects/(\\\\d+)/edit/[\\\\s\\\\S]{0,300}?data-project_code=\"' + escCode + '\"'));","pm.test('Project row found (matched by code)', () => pm.expect(!!m).to.be.true);","if (m) pm.collectionVariables.set('projectId', m[1]);"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/admin-projects/?q={{projectCode}}"}},{"name":"8. Verify department appears in admin list","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Department visible in list', () => pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('departmentName')));","var escaped = pm.collectionVariables.get('departmentName').replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');","const m = pm.response.text().match(new RegExp('data-id=\"(\\\\d+)\"[\\\\s\\\\S]{0,200}?data-name=\"' + escaped + '\"'));","pm.test('Department row found (matched by name)', () => pm.expect(!!m).to.be.true);","if (m) pm.collectionVariables.set('departmentId', m[1]);"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/admin-departments/?q={{departmentName}}"}},{"name":"9. Audit history accessible","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Admin audit page 200', () => pm.expect(pm.response.code).to.eql(200));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/admin-audit/"}},{"name":"10. Cleanup: delete created project","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('projectId')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Project deleted (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent back to projects list', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.include('admin-projects'));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"url":"{{baseUrl}}/admin-projects/{{projectId}}/delete/"}},{"name":"11. Verify project no longer listed","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Project gone after deletion', () =>","  pm.expect(pm.response.text()).to.not.include('data-project_code=\"' + pm.collectionVariables.get('projectCode') + '\"'));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/admin-projects/?q={{projectCode}}"}},{"name":"12. Cleanup: delete created department","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Department deleted (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent back to departments list', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.include('admin-departments'));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"action","value":"delete","type":"text"},{"key":"department_id","value":"{{departmentId}}","type":"text"}]},"url":"{{baseUrl}}/admin-departments/"}},{"name":"13. Verify department no longer listed","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Department gone after deletion', () =>","  pm.expect(pm.response.text()).to.not.include('data-name=\"' + pm.collectionVariables.get('departmentName') + '\"'));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/admin-departments/?q={{departmentName}}"}},{"name":"14. Logout - journey ends","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logged out (302)', () => pm.expect([200, 302]).to.include(pm.response.code));","pm.test('Session cleared', () => pm.expect(pm.cookies.get('sessionid') || '').to.eql(''));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"url":"{{baseUrl}}/logout/"}}]},{"name":"Journey B - Staff (QA/QC)","item":[{"name":"0a. Open /login/ (acquire a CSRF cookie)","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Clear per-run variables so a previous failed run cannot leak state into this one","['projectId','departmentId','ncrId','ncrRef','uniq'].forEach(function(k){ pm.collectionVariables.unset(k); });"]}},{"listen":"test","script":{"type":"text/javascript","exec":["// A live session from a previous run returns 302 to that role's dashboard - that is fine here","pm.test('Login route reachable', () => pm.expect([200, 302]).to.include(pm.response.code));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/login/"}},{"name":"0b. Ensure signed out (POST /logout/)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Sign-out attempted', () => pm.expect([200, 302, 403]).to.include(pm.response.code));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"description":"Clears any session left by an earlier failed run so step 1 really tests the anonymous case.","url":"{{baseUrl}}/logout/"}},{"name":"1. Open login page (fresh CSRF)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login page 200', () => pm.expect(pm.response.code).to.eql(200));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/login/"}},{"name":"2. Login as STAFF","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Redirected (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent to the staff dashboard', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.match(/staff-dashboard|staff\\/dashboard/));","pm.test('sessionid cookie issued', () => pm.expect(!!pm.cookies.get('sessionid')).to.be.true);"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"{{staffEmail}}","type":"text"},{"key":"password","value":"{{staffPassword}}","type":"text"}]},"url":"{{baseUrl}}/login/"}},{"name":"3. Staff dashboard visible","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Dashboard 200', () => pm.expect(pm.response.code).to.eql(200));","pm.test('Staff-only shell rendered (staff sidebar link)', () =>","  pm.expect(pm.response.text()).to.include('/staff-create/'));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff-dashboard/"}},{"name":"4. Open create form - capture project & department IDs","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Create form 200', () => pm.expect(pm.response.code).to.eql(200));","const body = pm.response.text();","const pSel = body.match(/name=\"project\"[\\s\\S]*?<\\/select>/);","const pOpt = pSel && pSel[0].match(/<option value=\"(\\d+)\"/);","const dSel = body.match(/name=\"department\"[\\s\\S]*?<\\/select>/);","const dOpt = dSel && dSel[0].match(/<option value=\"(\\d+)\"/);","if (pOpt) pm.collectionVariables.set('projectId', pOpt[1]);","if (dOpt) pm.collectionVariables.set('departmentId', dOpt[1]);","pm.test('Seed data available (project + department)', () => pm.expect(!!pOpt && !!dOpt).to.be.true);"]}}],"request":{"method":"GET","header":[],"description":"Needs at least one project and one department in the DB.","url":"{{baseUrl}}/staff-create/"}},{"name":"5. Raise a new NCR","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('uniq', Date.now());"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('NCR created (302)', () => pm.expect(pm.response.code).to.eql(302));","const m = (pm.response.headers.get('Location') || '').match(/staff-records\\/(\\d+)\\//);","pm.test('Sent to new NCR detail', () => pm.expect(!!m).to.be.true);","if (m) pm.collectionVariables.set('ncrId', m[1]);"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"project","value":"{{projectId}}","type":"text"},{"key":"department","value":"{{departmentId}}","type":"text"},{"key":"package_no","value":"PKG-{{uniq}}","type":"text"},{"key":"cause","value":"workmanship","type":"text"},{"key":"subject","value":"E2E staff journey NCR {{uniq}}","type":"text"},{"key":"issued_date","value":"2026-01-20","type":"text"},{"key":"required_date","value":"2026-02-20","type":"text"},{"key":"description","value":"Raised end-to-end by the staff journey","type":"text"}]},"url":"{{baseUrl}}/staff-create/"}},{"name":"6. Open NCR detail - verify created as Open","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('ncrId')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Detail 200', () => pm.expect(pm.response.code).to.eql(200));","pm.test('Reference auto-generated (NCR-...)', () => pm.expect(pm.response.text()).to.match(/NCR-\\d{4}-\\d{4}/));","const refM = pm.response.text().match(/NCR-\\d{4}-\\d{4}/);","if (refM) pm.collectionVariables.set('ncrRef', refM[0]);","// Check the status badge next to THIS NCR's reference, not a substring anywhere on the page","// The flash message repeats the reference before the card; match the title-bar markup instead","pm.test('Status badge is Open', () =>","  pm.expect(pm.response.text()).to.match(/NCR-\\d{4}-\\d{4}<\\/span>\\s*<span class=\"badge badge-open\">\\s*Open/));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff-records/{{ncrId}}/"}},{"name":"7. Start work: open -> in_progress","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('ncrId')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Moved to In Progress (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent back to the same NCR detail', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.include('/staff-records/' + pm.collectionVariables.get('ncrId') + '/'));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"new_status","value":"in_progress","type":"text"},{"key":"remarks","value":"E2E journey","type":"text"}]},"url":"{{baseUrl}}/staff-records/{{ncrId}}/"}},{"name":"8. Verify status In Progress","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('ncrId')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status badge is In Progress', () =>","  pm.expect(pm.response.text()).to.match(/NCR-\\d{4}-\\d{4}<\\/span>\\s*<span class=\"badge badge-in_progress\">\\s*In Progress/));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff-records/{{ncrId}}/"}},{"name":"9. Resolve the NCR (with resolution type)","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('ncrId')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Resolved (302)', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Sent back to the same NCR detail', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.include('/staff-records/' + pm.collectionVariables.get('ncrId') + '/'));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"new_status","value":"resolved","type":"text"},{"key":"resolution_type","value":"reapproved","type":"text"},{"key":"resolution_note","value":"Approved after rework","type":"text"},{"key":"remarks","value":"E2E journey","type":"text"}]},"url":"{{baseUrl}}/staff-records/{{ncrId}}/"}},{"name":"10. Verify Resolved + resolution history logged","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('ncrId')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status badge is Resolved', () =>","  pm.expect(pm.response.text()).to.match(/NCR-\\d{4}-\\d{4}<\\/span>\\s*<span class=\"badge badge-resolved\">\\s*Resolved/));","pm.test('History shows journey remarks', () => pm.expect(pm.response.text()).to.match(/E2E journey/));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff-records/{{ncrId}}/"}},{"name":"11. Audit history contains this NCR's reference","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["// Skip cleanly if an earlier step failed to capture an ID (avoids a 404 cascade)","if (!pm.collectionVariables.get('ncrRef')) {","  if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }","  else { postman.setNextRequest(null); }","}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Audit history 200', () => pm.expect(pm.response.code).to.eql(200));","pm.test('Audit row exists for this NCR', () =>","  pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('ncrRef')));"]}}],"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff/audit-history/?q={{ncrRef}}"}},{"name":"12. Export the NCR list (Excel)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Export 200', () => pm.expect(pm.response.code).to.eql(200));","pm.test('xlsx content type', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('spreadsheetml'));","pm.test('Sent as attachment', () =>","  pm.expect(pm.response.headers.get('Content-Disposition') || '').to.include('attachment'));","pm.test('Body is a non-empty xlsx (PK zip signature)', () => {","  pm.expect(pm.response.text().slice(0, 2)).to.eql('PK');","  pm.expect(Number(pm.response.headers.get('X-Export-Records'))).to.be.at.least(1);","  pm.expect(pm.response.headers.get('X-Export-Filename') || '').to.match(/\\.xlsx$/);","});"]}}],"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"formdata","formdata":[{"key":"export_type","value":"excel","type":"text"},{"key":"columns","value":"reference_no","type":"text"},{"key":"columns","value":"subject","type":"text"},{"key":"columns","value":"status","type":"text"}]},"url":"{{baseUrl}}/staff/export/"}},{"name":"13. Logout - journey ends","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logged out (302)', () => pm.expect([200, 302]).to.include(pm.response.code));","pm.test('Session cleared', () => pm.expect(pm.cookies.get('sessionid') || '').to.eql(''));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"url":"{{baseUrl}}/logout/"}}]}],"variable":[{"key":"csrfToken","value":"","type":"string"},{"key":"projectId","value":"","type":"string"},{"key":"departmentId","value":"","type":"string"},{"key":"ncrId","value":"","type":"string"},{"key":"projectCode","value":"","type":"string"},{"key":"projectName","value":"","type":"string"},{"key":"departmentName","value":"","type":"string"},{"key":"uniq","value":"","type":"string"}],"event":[{"listen":"test","script":{"type":"text/javascript","exec":["// Keep the Django CSRF token in sync with the csrftoken cookie","try {","  const ck = pm.cookies.get('csrftoken');","  if (ck) pm.collectionVariables.set('csrfToken', ck);","} catch (e) { /* cookie jar not available in this context */ }"]}}]}
":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"export_type","value":"pdf","type":"text"}]},"url":"{{baseUrl}}/staff/export/"}},{"name":"10. Staff export as Excel with no columns is rejected","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Rejected with 400', () => pm.expect(pm.response.code).to.eql(400));","pm.test('Explains the missing columns', () =>","  pm.expect(pm.response.text()).to.include('Select at least one column'));"]}}],"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"export_type","value":"excel","type":"text"}]},"url":"{{baseUrl}}/staff/export/"}},{"name":"11. POST /logout/ (reset)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logout tolerated', () => pm.expect([200, 302, 403]).to.include(pm.response.code));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"url":"{{baseUrl}}/logout/"}},{"name":"12. POST login as ADMIN (for the mirror checks)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Admin session established', () => pm.expect(pm.response.code).to.eql(302));","pm.test('Session issued', () => pm.expect(!!pm.cookies.get('sessionid')).to.be.true);"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"{{adminEmail}}","type":"text"},{"key":"password","value":"{{adminPassword}}","type":"text"}]},"url":"{{baseUrl}}/login/"}},{"name":"13. Admin cannot open the staff records page","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Staff page not served to admin', () => pm.expect(pm.response.code).to.not.eql(200));","pm.test('Sent to an admin dashboard', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.match(/admin-dashboard|reports\\/admin\\/dashboard/));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff-records/"}},{"name":"14. Admin cannot use the staff export endpoint","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Staff export not served to admin', () => pm.expect(pm.response.code).to.not.eql(200));","pm.test('Sent to an admin dashboard', () =>","  pm.expect(pm.response.headers.get('Location') || '').to.match(/admin-dashboard|reports\\/admin\\/dashboard/));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"GET","header":[],"url":"{{baseUrl}}/staff/export/"}},{"name":"15. POST /logout/ (leave the collection signed out)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Logged out', () => pm.expect([200, 302]).to.include(pm.response.code));"]}}],"protocolProfileBehavior":{"followRedirects":false},"request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrfToken}}"}],"url":"{{baseUrl}}/logout/"}}]}],"variable":[{"key":"csrfToken","value":"","type":"string"},{"key":"projectId","value":"","type":"string"},{"key":"departmentId","value":"","type":"string"},{"key":"ncrId","value":"","type":"string"},{"key":"projectCode","value":"","type":"string"},{"key":"projectName","value":"","type":"string"},{"key":"departmentName","value":"","type":"string"},{"key":"uniq","value":"","type":"string"}],"event":[{"listen":"test","script":{"type":"text/javascript","exec":["// Keep the Django CSRF token in sync with the csrftoken cookie","try {","  const ck = pm.cookies.get('csrftoken');","  if (ck) pm.collectionVariables.set('csrfToken', ck);","} catch (e) { /* cookie jar not available in this context */ }"]}}]}